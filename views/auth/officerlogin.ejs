<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

```
<title>Officer Login - SETU</title>

<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Arial, Helvetica, sans-serif;
        background: #f4f6f8;
        color: #333;
    }

    a {
        text-decoration: none;
    }

    /* Top bar */

    .top-bar {
        background: #17365d;
        color: #fff;
        padding: 7px 5%;
        font-size: 13px;
    }

    .top-bar-content {
        max-width: 1200px;
        margin: auto;

        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .top-links {
        display: flex;
        gap: 20px;
    }

    .top-links a {
        color: #fff;
    }

    .top-links a:hover {
        text-decoration: underline;
    }

    /* Header */

    header {
        background: #fff;
        border-bottom: 1px solid #ddd;
    }

    .header-content {
        max-width: 1200px;
        margin: auto;
        padding: 16px 5%;

        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .brand-icon {
        width: 52px;
        height: 52px;

        border: 1px solid #ccc;
        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        color: #17365d;
        font-size: 24px;
    }

    .brand h1 {
        color: #17365d;
        font-size: 24px;
        margin-bottom: 3px;
    }

    .brand p {
        color: #666;
        font-size: 12px;
    }

    .home-btn {
        border: 1px solid #ccc;
        background: #fff;

        color: #333;

        padding: 9px 15px;
        border-radius: 3px;

        font-size: 13px;
    }

    .home-btn:hover {
        background: #f2f2f2;
    }

    /* Tricolor */

    .tricolor {
        display: flex;
        height: 3px;
    }

    .saffron {
        flex: 1;
        background: #e87518;
    }

    .white {
        flex: 1;
        background: #fff;
    }

    .green {
        flex: 1;
        background: #138808;
    }

    /* Main */

    main {
        max-width: 1200px;
        min-height: calc(100vh - 190px);

        margin: auto;
        padding: 45px 5%;
    }

    .breadcrumb {
        color: #777;
        font-size: 13px;
        margin-bottom: 25px;
    }

    .breadcrumb a {
        color: #155a96;
    }

    .breadcrumb i {
        margin: 0 7px;
        font-size: 10px;
    }

    /* Login section */

    .login-section {
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 60px;

        align-items: center;
    }

    /* Left side */

    .welcome h2 {
        color: #17365d;
        font-size: 32px;
        margin-bottom: 15px;
    }

    .welcome p {
        max-width: 600px;

        color: #666;
        font-size: 15px;
        line-height: 1.7;

        margin-bottom: 25px;
    }

    .officer-note {
        max-width: 600px;

        background: #fff;
        border: 1px solid #ddd;

        border-left: 4px solid #17365d;

        padding: 18px;

        margin-bottom: 20px;
    }

    .officer-note h3 {
        color: #17365d;
        font-size: 15px;
        margin-bottom: 7px;
    }

    .officer-note p {
        font-size: 13px;
        line-height: 1.6;
        margin: 0;
    }

    .services {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;

        max-width: 600px;
    }

    .service {
        background: #fff;
        border: 1px solid #ddd;

        padding: 15px;

        display: flex;
        gap: 12px;
    }

    .service i {
        color: #155a96;
        font-size: 18px;
        margin-top: 2px;
    }

    .service h3 {
        color: #333;
        font-size: 14px;
        margin-bottom: 5px;
    }

    .service p {
        color: #777;
        font-size: 12px;
        line-height: 1.4;
        margin: 0;
    }

    /* Login box */

    .login-box {
        background: #fff;

        border: 1px solid #d6d6d6;

        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    }

    .login-heading {
        background: #f7f8f9;
        border-bottom: 1px solid #ddd;

        padding: 20px 25px;
    }

    .login-heading h2 {
        color: #17365d;
        font-size: 21px;
        margin-bottom: 5px;
    }

    .login-heading p {
        color: #777;
        font-size: 13px;
    }

    .login-form {
        padding: 25px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;

        color: #333;
        font-size: 14px;
        font-weight: 600;

        margin-bottom: 7px;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        height: 44px;

        border: 1px solid #bbb;
        border-radius: 3px;

        background: #fff;

        padding: 0 12px;

        color: #333;
        font-size: 14px;

        outline: none;
    }

    .form-group input:focus,
    .form-group select:focus {
        border-color: #155a96;

        box-shadow: 0 0 0 2px rgba(21, 90, 150, 0.1);
    }

    .form-group select {
        cursor: pointer;
    }

    /* Password */

    .password-field {
        position: relative;
    }

    .password-field input {
        padding-right: 42px;
    }

    .password-toggle {
        position: absolute;

        right: 10px;
        top: 50%;

        transform: translateY(-50%);

        border: none;
        background: none;

        color: #777;

        cursor: pointer;
    }

    .password-toggle:hover {
        color: #155a96;
    }

    /* Options */

    .form-options {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 20px;

        font-size: 13px;
    }

    .remember {
        display: flex;
        align-items: center;
        gap: 6px;

        color: #666;

        cursor: pointer;
    }

    .remember input {
        accent-color: #155a96;
    }

    .forgot {
        color: #155a96;
        font-weight: 600;
    }

    .forgot:hover {
        text-decoration: underline;
    }

    /* Login button */

    .login-btn {
        width: 100%;
        height: 44px;

        border: none;
        border-radius: 3px;

        background: #155a96;
        color: #fff;

        font-size: 14px;
        font-weight: 600;

        cursor: pointer;
    }

    .login-btn:hover {
        background: #104a7c;
    }

    /* Security warning */

    .warning-box {
        background: #fff8e6;

        border: 1px solid #ead7a1;
        border-left: 4px solid #d89b00;

        padding: 12px;

        margin-top: 18px;

        color: #765b16;

        font-size: 11px;
        line-height: 1.5;
    }

    .warning-box i {
        margin-right: 5px;
    }

    /* Footer */

    footer {
        background: #17365d;
        color: #fff;

        padding: 18px 5%;
    }

    .footer-content {
        max-width: 1200px;
        margin: auto;

        display: flex;
        justify-content: space-between;
        align-items: center;

        gap: 20px;
    }

    footer p {
        color: #dce3ea;
        font-size: 12px;
    }

    .footer-links {
        display: flex;
        gap: 18px;
    }

    .footer-links a {
        color: #fff;
        font-size: 12px;
    }

    .footer-links a:hover {
        text-decoration: underline;
    }

    /* Tablet */

    @media (max-width: 850px) {

        .login-section {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .welcome {
            text-align: center;
        }

        .welcome p {
            margin-left: auto;
            margin-right: auto;
        }

        .officer-note {
            margin-left: auto;
            margin-right: auto;
            text-align: left;
        }

        .services {
            margin: auto;
            text-align: left;
        }

        .login-box {
            width: 100%;
            max-width: 480px;
            margin: auto;
        }
    }

    /* Mobile */

    @media (max-width: 600px) {

        .top-bar {
            padding: 7px 4%;
        }

        .top-bar-content {
            justify-content: center;
        }

        .top-bar-content > span {
            display: none;
        }

        .top-links {
            gap: 15px;
        }

        .header-content {
            padding: 13px 4%;
        }

        .brand {
            gap: 9px;
        }

        .brand-icon {
            width: 45px;
            height: 45px;
            font-size: 20px;
        }

        .brand h1 {
            font-size: 20px;
        }

        .brand p {
            font-size: 10px;
        }

        .home-btn {
            padding: 8px 10px;
            font-size: 12px;
        }

        main {
            padding: 28px 4%;
        }

        .welcome h2 {
            font-size: 26px;
        }

        .welcome p {
            font-size: 14px;
        }

        .services {
            grid-template-columns: 1fr;
        }

        .login-form {
            padding: 20px;
        }

        .login-methods {
            grid-template-columns: 1fr;
        }

        .footer-content {
            flex-direction: column;
            text-align: center;
        }

        .footer-links {
            flex-wrap: wrap;
            justify-content: center;
        }
    }

    @media (max-width: 400px) {

        .brand p {
            display: none;
        }

        .form-options {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .login-heading {
            padding: 18px 20px;
        }

        .login-form {
            padding: 18px;
        }
    }
</style>
```

</head>

<body>

<!-- Top bar -->

<div class="top-bar">

    <div class="top-bar-content">

        <span>
            Government Officer Services
        </span>

        <div class="top-links">
            <a href="#">Accessibility</a>
            <a href="#">Help</a>
            <a href="#">हिन्दी</a>
        </div>

    </div>

</div>


<!-- Header -->

<header>

    <div class="header-content">

        <a href="/" class="brand">

            <div class="brand-icon">
                <i class="fas fa-landmark"></i>
            </div>

            <div>
                <h1>SETU</h1>
                <p>Citizen Service Delivery Platform</p>
            </div>

        </a>


        <a href="/" class="home-btn">
            <i class="fas fa-home"></i>
            Home
        </a>

    </div>


    <div class="tricolor">
        <div class="saffron"></div>
        <div class="white"></div>
        <div class="green"></div>
    </div>

</header>


<!-- Main -->

<main>

    <div class="breadcrumb">

        <a href="/">
            <i class="fas fa-home"></i>
            Home
        </a>

        <i class="fas fa-chevron-right"></i>

        Officer Login

    </div>


    <div class="login-section">


        <!-- Information -->

        <div class="welcome">

            <h2>Government Officer Portal</h2>

            <p>
                Authorized officers can use this portal to review
                citizen applications, verify documents and manage
                requests assigned to their department.
            </p>


            <div class="officer-note">

                <h3>
                    <i class="fas fa-circle-info"></i>
                    For authorised personnel only
                </h3>

                <p>
                    Please use the officer credentials provided by
                    your department. Do not share your login details
                    with anyone.
                </p>

            </div>


            <div class="services">

                <div class="service">

                    <i class="fas fa-file-circle-check"></i>

                    <div>
                        <h3>Verify Applications</h3>

                        <p>
                            Review and process citizen applications.
                        </p>
                    </div>

                </div>


                <div class="service">

                    <i class="fas fa-file-arrow-up"></i>

                    <div>
                        <h3>Request Documents</h3>

                        <p>
                            Ask citizens for additional documents.
                        </p>
                    </div>

                </div>


                <div class="service">

                    <i class="fas fa-building"></i>

                    <div>
                        <h3>Department Workflow</h3>

                        <p>
                            Coordinate applications across departments.
                        </p>
                    </div>

                </div>


                <div class="service">

                    <i class="fas fa-chart-line"></i>

                    <div>
                        <h3>Track Requests</h3>

                        <p>
                            Monitor application and workflow status.
                        </p>
                    </div>

                </div>

            </div>

        </div>


        <!-- Login -->

        <div class="login-box">

            <div class="login-heading">

                <h2>
                    <i class="fas fa-user-tie"></i>
                    Officer Login
                </h2>

                <p>
                    Enter your official credentials to continue
                </p>

            </div>


            <div class="login-form">

                <form
                    id="officerLoginForm"
                    action="/auth/officerlogin"
                    method="POST"
                >


                    <div class="form-group">

                        <label for="officerId">
                            Officer ID
                        </label>

                        <input
                            type="text"
                            id="officerId"
                            name="officerId"
                            placeholder="Enter your Officer ID"
                            autocomplete="username"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label for="department">
                            Department
                        </label>

                        <select
                            id="department"
                            name="department"
                            required
                        >

                            <option value="">
                                Select your department
                            </option>

                            <option value="dept-a">
                                Department A - Citizen Registry
                            </option>

                            <option value="dept-b">
                                Department B - Income/Eligibility
                            </option>

                            <option value="dept-c">
                                Department C - Scheme/Application
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label for="password">
                            Password
                        </label>

                        <div class="password-field">

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Enter your password"
                                autocomplete="current-password"
                                required
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                onclick="togglePassword()"
                                aria-label="Show password"
                            >
                                <i class="fas fa-eye"></i>
                            </button>

                        </div>

                    </div>


                    <div class="form-options">

                        <label class="remember">

                            <input
                                type="checkbox"
                                name="remember"
                            >

                            Remember me

                        </label>


                        <a href="#" class="forgot">
                            Forgot password?
                        </a>

                    </div>


                    <button
                        type="submit"
                        class="login-btn"
                    >
                        <i class="fas fa-sign-in-alt"></i>
                        Login to Portal
                    </button>


                    <div class="warning-box">

                        <i class="fas fa-triangle-exclamation"></i>

                        This is a restricted area for authorised
                        government personnel. Unauthorised access
                        is prohibited.

                    </div>

                </form>

            </div>

        </div>

    </div>

</main>


<!-- Footer -->

<footer>

    <div class="footer-content">

        <p>
            © <span id="year"></span> SETU Citizen Service Portal
        </p>

        <div class="footer-links">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Use</a>
            <a href="#">Help</a>
            <a href="#">Contact Us</a>
        </div>

    </div>

</footer>


<script>

    function togglePassword() {

        const password = document.getElementById("password");
        const button = document.querySelector(".password-toggle");
        const icon = button.querySelector("i");

        if (password.type === "password") {

            password.type = "text";

            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");

        } else {

            password.type = "password";

            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");

        }
    }

    document.getElementById("year").textContent =
        new Date().getFullYear();

</script>


</body>

</html>
