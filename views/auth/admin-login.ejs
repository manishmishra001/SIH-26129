<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - SETU</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .admin-login-container {
            width: 100%;
            max-width: 500px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 12px 48px rgba(0, 0, 0, 0.3);
            padding: 60px 45px;
            position: relative;
            overflow: hidden;
        }

        .admin-login-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #0066cc, #00b4d8, #0066cc);
            background-size: 200% auto;
            animation: gradientShift 3s ease infinite;
        }

        @keyframes gradientShift {
            0% { background-position: 0% center; }
            50% { background-position: 100% center; }
            100% { background-position: 0% center; }
        }

        .admin-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .admin-badge {
            display: inline-block;
            background: linear-gradient(135deg, #0066cc, #00b4d8);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }

        .admin-header h1 {
            font-size: 2rem;
            color: #1a1a1a;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .admin-header p {
            color: #666666;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #1a1a1a;
            font-size: 0.95rem;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #0066cc;
            box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
        }

        .password-container {
            position: relative;
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #666666;
            font-size: 1.1rem;
            padding: 5px;
        }

        .toggle-password:hover {
            color: #0066cc;
        }

        .security-options {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
            font-size: 0.9rem;
        }

        .security-options label {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            margin: 0;
            font-weight: 500;
        }

        .security-options input[type="checkbox"] {
            cursor: pointer;
            width: 16px;
            height: 16px;
            accent-color: #0066cc;
        }

        .forgot-password {
            display: block;
            text-align: right;
            color: #0066cc;
            text-decoration: none;
            font-size: 0.9rem;
            margin-bottom: 25px;
            font-weight: 600;
            transition: color 0.3s ease;
        }

        .forgot-password:hover {
            color: #0052a3;
        }

        .login-btn {
            width: 100%;
            padding: 12px 20px;
            background: linear-gradient(135deg, #0066cc 0%, #00b4d8 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 102, 204, 0.4);
        }

        .login-btn:active {
            transform: translateY(0);
        }

        .security-notice {
            background: linear-gradient(135deg, #fff8e1 0%, #fff3cd 100%);
            border: 1px solid #ffecb5;
            border-left: 4px solid #ffc107;
            padding: 15px;
            border-radius: 8px;
            font-size: 0.85rem;
            color: #856404;
            margin-top: 20px;
            line-height: 1.6;
        }

        .security-notice strong {
            display: block;
            margin-bottom: 5px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #0066cc;
            text-decoration: none;
            font-size: 0.9rem;
            margin-bottom: 25px;
            font-weight: 600;
            transition: color 0.3s ease;
        }

        .back-link:hover {
            color: #0052a3;
        }

        .restricted-access {
            background: #f8f9fa;
            padding: 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            color: #666666;
            text-align: center;
            margin-top: 20px;
            border: 1px dashed #e0e0e0;
        }

        @media (max-width: 480px) {
            .admin-login-container {
                padding: 40px 25px;
            }

            .admin-header h1 {
                font-size: 1.6rem;
            }

            .security-options {
                flex-direction: column;
                gap: 12px;
            }
        }
    </style>
</head>
<body>
    <div class="admin-login-container">
        <a href="index.html" class="back-link">
            <i class="fas fa-arrow-left"></i> Back to Home
        </a>

        <div class="admin-header">
            <div class="admin-badge">
                <i class="fas fa-shield-alt"></i> Administrator Only
            </div>
            <h1>Admin Portal</h1>
            <p>System monitoring, analytics, and user management dashboard</p>
        </div>

        <form id="adminLoginForm">
            <div class="form-group">
                <label for="adminId">Administrator ID</label>
                <input 
                    type="text" 
                    id="adminId" 
                    placeholder="Enter your Admin ID" 
                    required
                    autocomplete="username"
                >
            </div>

            <div class="form-group">
                <label for="adminPassword">Password</label>
                <div class="password-container">
                    <input 
                        type="password" 
                        id="adminPassword" 
                        placeholder="Enter your password" 
                        required
                        autocomplete="current-password"
                    >
                    <button type="button" class="toggle-password" onclick="toggleAdminPassword()">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="security-options">
                <label>
                    <input type="checkbox" name="remember"> 
                    Remember this device
                </label>
                <a href="#" class="forgot-password" style="margin: 0; display: inline;">
                    Forgot password?
                </a>
            </div>

            <button type="submit" class="login-btn">
                <i class="fas fa-lock"></i> Access Admin Portal
            </button>

            <div class="security-notice">
                <strong>🔒 Security Notice</strong>
                This portal is restricted to authorized administrators only. All access is logged and monitored for security purposes. Unauthorized access attempts will be reported to security.
            </div>

            <div class="restricted-access">
                <i class="fas fa-lock"></i> Restricted Access - Authorized Personnel Only
            </div>
        </form>
    </div>

    <script>
        function toggleAdminPassword() {
            const passwordInput = document.getElementById('adminPassword');
            const toggleBtn = document.querySelector('.toggle-password');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleBtn.innerHTML = '<i class="fas fa-eye-slash"></i>';
            } else {
                passwordInput.type = 'password';
                toggleBtn.innerHTML = '<i class="fas fa-eye"></i>';
            }
        }

        document.getElementById('adminLoginForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const adminId = document.getElementById('adminId').value;
            const password = document.getElementById('adminPassword').value;
            
            // Mock authentication (in real app, this would be server-side)
            if (adminId && password.length >= 8) {
                // Store session
                localStorage.setItem('adminSession', JSON.stringify({
                    id: adminId,
                    loginTime: new Date(),
                    role: 'super_admin'
                }));
                window.location.href = 'admin-dashboard.html';
            } else {
                alert('Invalid credentials. Admin ID and password (min 8 chars) required.');
            }
        });
    </script>
</body>
</html>