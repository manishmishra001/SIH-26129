<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Citizen Dashboard - SETU</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #0066cc;
            --secondary: #00b4d8;
            --success: #28a745;
            --warning: #ffc300;
            --danger: #dc3545;
            --light: #f8f9fa;
            --dark: #1a1a1a;
            --border: #e0e0e0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: var(--light);
            color: var(--dark);
        }

        .dashboard {
            display: grid;
            grid-template-columns: 250px 1fr;
            min-height: 100vh;
        }

        /* ============ SIDEBAR ============ */

        .sidebar {
            background: white;
            border-right: 1px solid var(--border);
            padding: 30px 0;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            box-shadow: 2px 0 8px rgba(0, 0, 0, 0.05);
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 20px;
            margin-bottom: 40px;
            color: var(--primary);
            font-size: 1.3rem;
            font-weight: bold;
        }

        .sidebar-logo i {
            font-size: 1.6rem;
        }

        .sidebar-menu {
            list-style: none;
        }

        .sidebar-menu li {
            margin: 0;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            color: #666666;
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .sidebar-menu a:hover {
            background: var(--light);
            color: var(--primary);
            border-left: 4px solid var(--primary);
            padding-left: 16px;
        }

        .sidebar-menu a.active {
            background: #f0f4ff;
            color: var(--primary);
            border-left: 4px solid var(--primary);
            padding-left: 16px;
        }

        .sidebar-menu i {
            width: 20px;
            text-align: center;
            font-size: 1.1rem;
        }

        .sidebar-footer {
            position: absolute;
            bottom: 30px;
            left: 0;
            right: 0;
            padding: 0 20px;
            border-top: 1px solid var(--border);
            padding-top: 20px;
        }

        .logout-btn {
            width: 100%;
            padding: 10px 15px;
            background: #fff3cd;
            color: #856404;
            border: 1px solid #ffc107;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: #ffc107;
            color: white;
        }

        /* ============ MAIN CONTENT ============ */

        .main-content {
            padding: 40px;
            overflow-y: auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            background: white;
            padding: 20px 30px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .header h1 {
            font-size: 1.8rem;
            color: var(--dark);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-avatar {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .user-details h3 {
            font-size: 0.95rem;
            color: var(--dark);
            margin-bottom: 2px;
        }

        .user-details p {
            font-size: 0.85rem;
            color: #666666;
        }

        /* ============ CARDS GRID ============ */

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            background: white;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        }

        .card-1 { border-left-color: #667eea; }
        .card-2 { border-left-color: #f093fb; }
        .card-3 { border-left-color: #4facfe; }
        .card-4 { border-left-color: #43e97b; }

        .card-number {
            font-size: 2.5rem;
            font-weight: bold;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 10px;
        }

        .card-2 .card-number {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .card-3 .card-number {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .card-4 .card-number {
            background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .card-label {
            font-size: 0.85rem;
            color: #666666;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* ============ SECTION ============ */

        .section {
            background: white;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .section-title {
            font-size: 1.4rem;
            margin-bottom: 25px;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            color: var(--primary);
            font-size: 1.3rem;
        }

        /* ============ APPLICATIONS TABLE ============ */

        .applications-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        .applications-table thead {
            background: var(--light);
        }

        .applications-table th {
            padding: 12px 15px;
            text-align: left;
            font-weight: 600;
            color: var(--dark);
            border-bottom: 2px solid var(--border);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .applications-table td {
            padding: 15px;
            border-bottom: 1px solid var(--border);
            font-size: 0.95rem;
        }

        .applications-table tr:hover {
            background: var(--light);
        }

        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-approved {
            background: #d4edda;
            color: #155724;
        }

        .status-rejected {
            background: #f8d7da;
            color: #721c24;
        }

        .status-processing {
            background: #d1ecf1;
            color: #0c5460;
        }

        .action-btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .action-btn:hover {
            background: #0052a3;
        }

        /* ============ QUICK ACTIONS ============ */

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .action-card {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .action-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(0, 102, 204, 0.3);
        }

        .action-card i {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .action-card p {
            font-size: 0.9rem;
            font-weight: 600;
        }

        /* ============ RESPONSIVE ============ */

        @media (max-width: 768px) {
            .dashboard {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: fixed;
                left: -250px;
                height: 100vh;
                z-index: 1000;
                transition: left 0.3s ease;
            }

            .sidebar.active {
                left: 0;
            }

            .main-content {
                padding: 20px;
            }

            .header {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }

            .cards-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .applications-table {
                font-size: 0.85rem;
            }

            .applications-table th,
            .applications-table td {
                padding: 10px 8px;
            }

            @supports (-webkit-touch-callout: none) {
                .sidebar {
                    width: 250px;
                    position: relative;
                    left: 0;
                }
            }
        }

        @media (max-width: 480px) {
            .cards-grid {
                grid-template-columns: 1fr;
            }

            .quick-actions {
                grid-template-columns: 1fr;
            }

            .header h1 {
                font-size: 1.4rem;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <i class="fas fa-network-wired"></i>
                SETU
            </div>

            <ul class="sidebar-menu">
                <li><a href="#" class="active"><i class="fas fa-home"></i> Dashboard</a></li>
                <li><a href="#"><i class="fas fa-file-alt"></i> My Services</a></li>
                <li><a href="#"><i class="fas fa-paper-plane"></i> Applications</a></li>
                <li><a href="#"><i class="fas fa-history"></i> Track Status</a></li>
                <li><a href="#"><i class="fas fa-file"></i> Documents</a></li>
                <li><a href="#"><i class="fas fa-handshake"></i> Consent</a></li>
                <li><a href="#"><i class="fas fa-bell"></i> Notifications</a></li>
                <li><a href="#"><i class="fas fa-exclamation-circle"></i> Grievances</a></li>
                <li><a href="#"><i class="fas fa-user"></i> Profile</a></li>
                <li><a href="#"><i class="fas fa-question-circle"></i> Help & Support</a></li>
            </ul>

            <div class="sidebar-footer">
                <form action="/auth/logout" method="POST">
                    <button type="submit" class="logout-btn">Logout</button>
                </form>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <div class="header">
                <h1>Welcome back, <%= citizen.firstName %>!</h1>
                <div class="user-info">
                    <div class="user-avatar"><%= citizen.firstName.charAt(0).toUpperCase() %><%= citizen.lastName.charAt(0).toUpperCase() %></div>
                    <div class="user-details">
                        <h3><%= citizen.firstName %> <%= citizen.lastName %></h3>
                        <p>xxxx xxxx xxxx <%= citizen.aadhaarlast4 %></p>
                    </div>
                </div>
            </div>

            <!-- STATS CARDS -->
            <div class="cards-grid">
                <div class="card card-1">
                    <div class="card-number">3</div>
                    <div class="card-label">Active Applications</div>
                </div>
                <div class="card card-2">
                    <div class="card-number">1</div>
                    <div class="card-label">Approved</div>
                </div>
                <div class="card card-3">
                    <div class="card-number">2</div>
                    <div class="card-label">Under Review</div>
                </div>
                <div class="card card-4">
                    <div class="card-number">12</div>
                    <div class="card-label">Documents</div>
                </div>
            </div>

            <!-- QUICK ACTIONS -->
            <div class="section">
                <div class="section-title">
                    <i class="fas fa-bolt"></i> Quick Actions
                </div>
                <div class="quick-actions">
                    <a href="#" class="action-card">
                        <i class="fas fa-plus"></i>
                        <p>Apply for Service</p>
                    </a>
                    <a href="#" class="action-card" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                        <i class="fas fa-search"></i>
                        <p>Track Application</p>
                    </a>
                    <a href="#" class="action-card" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-upload"></i>
                        <p>Upload Document</p>
                    </a>
                    <a href="#" class="action-card" style="background: linear-gradient(135deg, #43e97b, #38f9d7);">
                        <i class="fas fa-handshake"></i>
                        <p>Manage Consent</p>
                    </a>
                </div>
            </div>

            <!-- RECENT APPLICATIONS -->
            <div class="section">
                <div class="section-title">
                    <i class="fas fa-history"></i> Recent Applications
                </div>
                <table class="applications-table">
                    <thead>
                        <tr>
                            <th>Scheme Name</th>
                            <th>Application ID</th>
                            <th>Submitted Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Pradhan Mantri Awas Yojana</strong></td>
                            <td>#APP-2026-001</td>
                            <td>15 Aug 2026</td>
                            <td><span class="status-badge status-approved">Approved</span></td>
                            <td><button class="action-btn">View</button></td>
                        </tr>
                        <tr>
                            <td><strong>PM-KISAN Scheme</strong></td>
                            <td>#APP-2026-002</td>
                            <td>12 Aug 2026</td>
                            <td><span class="status-badge status-processing">Processing</span></td>
                            <td><button class="action-btn">View</button></td>
                        </tr>
                        <tr>
                            <td><strong>Atal Pension Yojana</strong></td>
                            <td>#APP-2026-003</td>
                            <td>08 Aug 2026</td>
                            <td><span class="status-badge status-processing">Processing</span></td>
                            <td><button class="action-btn">View</button></td>
                        </tr>
                        <tr>
                            <td><strong>MGNREGA Application</strong></td>
                            <td>#APP-2026-004</td>
                            <td>05 Aug 2026</td>
                            <td><span class="status-badge status-rejected">Rejected</span></td>
                            <td><button class="action-btn">Reapply</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- NOTIFICATIONS -->
            <div class="section">
                <div class="section-title">
                    <i class="fas fa-bell"></i> Recent Notifications
                </div>
                <div style="display: grid; gap: 12px;">
                    <div style="padding: 15px; background: #f0f4ff; border-left: 4px solid var(--primary); border-radius: 6px;">
                        <p><strong>Your Pradhan Mantri Awas Yojana application has been approved!</strong></p>
                        <small style="color: #666666;">2 days ago</small>
                    </div>
                    <div style="padding: 15px; background: #fff3cd; border-left: 4px solid var(--warning); border-radius: 6px;">
                        <p><strong>Additional document required for PM-KISAN application</strong></p>
                        <small style="color: #666666;">5 days ago</small>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Toggle sidebar on mobile
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.querySelector('.sidebar');
            const menuItems = document.querySelectorAll('.sidebar-menu a');
            
            menuItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    if (window.innerWidth <= 768) {
                        sidebar.classList.remove('active');
                    }
                });
            });
        });
    </script>
</body>
</html>