<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - SETU</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #0066cc;
            --secondary: #00b4d8;
            --success: #28a745;
            --warning: #ffc300;
            --danger: #dc3545;
            --light: #f8f9fa;
            --dark: #1a1a1a;
            --border: #e0e0e0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: var(--light);
            color: var(--dark);
        }

        .dashboard {
            display: grid;
            grid-template-columns: 250px 1fr;
            min-height: 100vh;
        }

        /* ============ SIDEBAR ============ */

        .sidebar {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: white;
            padding: 30px 0;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 20px;
            margin-bottom: 40px;
            font-size: 1.3rem;
            font-weight: bold;
        }

        .sidebar-logo i {
            font-size: 1.6rem;
            color: var(--secondary);
        }

        .sidebar-menu {
            list-style: none;
        }

        .sidebar-menu li {
            margin: 0;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .sidebar-menu a:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border-left: 4px solid var(--secondary);
            padding-left: 16px;
        }

        .sidebar-menu a.active {
            background: rgba(0, 180, 216, 0.2);
            color: white;
            border-left: 4px solid var(--secondary);
            padding-left: 16px;
        }

        .sidebar-menu i {
            width: 20px;
            text-align: center;
            font-size: 1.1rem;
        }

        .sidebar-footer {
            position: absolute;
            bottom: 30px;
            left: 0;
            right: 0;
            padding: 0 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 20px;
        }

        .logout-btn {
            width: 100%;
            padding: 10px 15px;
            background: var(--danger);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: #bb2d3b;
            transform: translateY(-2px);
        }

        /* ============ MAIN CONTENT ============ */

        .main-content {
            padding: 40px;
            overflow-y: auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            background: white;
            padding: 20px 30px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .header h1 {
            font-size: 1.8rem;
            color: var(--dark);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-avatar {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .user-details h3 {
            font-size: 0.95rem;
            color: var(--dark);
            margin-bottom: 2px;
        }

        .user-details p {
            font-size: 0.85rem;
            color: #666666;
        }

        /* ============ STATS ============ */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: white;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            border-top: 4px solid var(--primary);
        }

        .stat-card.critical {
            border-top-color: var(--danger);
        }

        .stat-card.warning {
            border-top-color: var(--warning);
        }

        .stat-card.success {
            border-top-color: var(--success);
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 10px;
        }

        .stat-card.critical .stat-number {
            color: var(--danger);
        }

        .stat-card.warning .stat-number {
            color: var(--warning);
        }

        .stat-card.success .stat-number {
            color: var(--success);
        }

        .stat-label {
            font-size: 0.85rem;
            color: #666666;
            font-weight: 600;
            text-transform: uppercase;
        }

        /* ============ SECTION ============ */

        .section {
            background: white;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .section-title {
            font-size: 1.4rem;
            margin-bottom: 25px;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            color: var(--primary);
            font-size: 1.3rem;
        }

        /* ============ SYSTEM HEALTH ============ */

        .health-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            border: 1px solid var(--border);
            border-radius: 8px;
            margin-bottom: 12px;
        }

        .health-name {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 600;
        }

        .health-status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .status-operational {
            background: #d4edda;
            color: #155724;
        }

        .status-warning {
            background: #fff3cd;
            color: #856404;
        }

        .status-critical {
            background: #f8d7da;
            color: #721c24;
        }

        /* ============ DEPARTMENTS ============ */

        .dept-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .dept-card {
            background: var(--light);
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid var(--primary);
            transition: all 0.3s ease;
        }

        .dept-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        }

        .dept-name {
            font-weight: 700;
            margin-bottom: 10px;
            color: var(--dark);
        }

        .dept-info {
            font-size: 0.9rem;
            color: #666666;
            line-height: 1.6;
        }

        .dept-info span {
            display: block;
            margin: 5px 0;
        }

        /* ============ TABLE ============ */

        .admin-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        .admin-table thead {
            background: var(--light);
        }

        .admin-table th {
            padding: 12px 15px;
            text-align: left;
            font-weight: 600;
            color: var(--dark);
            border-bottom: 2px solid var(--border);
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .admin-table td {
            padding: 15px;
            border-bottom: 1px solid var(--border);
            font-size: 0.95rem;
        }

        .admin-table tr:hover {
            background: var(--light);
        }

        /* ============ RESPONSIVE ============ */

        @media (max-width: 768px) {
            .dashboard {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: fixed;
                left: -250px;
                height: 100vh;
                z-index: 1000;
                transition: left 0.3s ease;
            }

            .sidebar.active {
                left: 0;
            }

            .main-content {
                padding: 20px;
            }

            .header {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .dept-grid {
                grid-template-columns: 1fr;
            }

            .admin-table {
                font-size: 0.85rem;
            }

            .admin-table th,
            .admin-table td {
                padding: 10px 8px;
            }
        }

        @media (max-width: 480px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .header h1 {
                font-size: 1.4rem;
            }

            .stat-number {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <i class="fas fa-shield-alt"></i>
                SETU ADMIN
            </div>

            <ul class="sidebar-menu">
                <li><a href="#" class="active"><i class="fas fa-home"></i> Dashboard</a></li>
                <li><a href="#"><i class="fas fa-sitemap"></i> Departments</a></li>
                <li><a href="#"><i class="fas fa-link"></i> Integrations</a></li>
                <li><a href="#"><i class="fas fa-users"></i> User Management</a></li>
                <li><a href="#"><i class="fas fa-key"></i> Access Control</a></li>
                <li><a href="#"><i class="fas fa-eye"></i> Audit Logs</a></li>
                <li><a href="#"><i class="fas fa-chart-bar"></i> Analytics</a></li>
                <li><a href="#"><i class="fas fa-heartbeat"></i> System Health</a></li>
                <li><a href="#"><i class="fas fa-cog"></i> Settings</a></li>
                <li><a href="#"><i class="fas fa-bell"></i> Alerts</a></li>
            </ul>

            <div class="sidebar-footer">
                <form action="/auth/logout" method="POST">
                    <button type="submit" class="logout-btn">Logout</button>
                </form>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <div class="header">
                <h1>Administration Dashboard</h1>
                <div class="user-info">
                    <div class="user-avatar">SA</div>
                    <div class="user-details">
                        <h3>System Administrator</h3>
                        <p>Super Admin - Full Access</p>
                    </div>
                </div>
            </div>

            <!-- KEY METRICS -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">2,847</div>
                    <div class="stat-label">Total Applications</div>
                </div>
                <div class="stat-card success">
                    <div class="stat-number">89.2%</div>
                    <div class="stat-label">System Uptime</div>
                </div>
                <div class="stat-card warning">
                    <div class="stat-number">12</div>
                    <div class="stat-label">Pending Approvals</div>
                </div>
                <div class="stat-card critical">
                    <div class="stat-number">2</div>
                    <div class="stat-label">Critical Alerts</div>
                </div>
            </div>

            <!-- SYSTEM HEALTH -->
            <div class="section">
                <div class="section-title">
                    <i class="fas fa-heartbeat"></i> System Health Status
                </div>
                <div class="health-item">
                    <div class="health-name">
                        <i class="fas fa-server"></i> API Gateway
                    </div>
                    <span class="health-status status-operational">Operational</span>
                </div>
                <div class="health-item">
                    <div class="health-name">
                        <i class="fas fa-database"></i> MongoDB Database
                    </div>
                    <span class="health-status status-operational">Operational</span>
                </div>
                <div class="health-item">
                    <div class="health-name">
                        <i class="fas fa-link"></i> Department A Connection
                    </div>
                    <span class="health-status status-operational">Connected</span>
                </div>
                <div class="health-item">
                    <div class="health-name">
                        <i class="fas fa-link"></i> Department B Connection
                    </div>
                    <span class="health-status status-warning">Slow Response</span>
                </div>
                <div class="health-item">
                    <div class="health-name">
                        <i class="fas fa-link"></i> Department C Connection
                    </div>
                    <span class="health-status status-critical">Disconnected</span>
                </div>
            </div>

            <!-- CONNECTED DEPARTMENTS -->
            <div class="section">
                <div class="section-title">
                    <i class="fas fa-sitemap"></i> Connected Government Departments
                </div>
                <div class="dept-grid">
                    <div class="dept-card">
                        <div class="dept-name">Department A</div>
                        <div class="dept-info">
                            <span><strong>Citizens Registry</strong></span>
                            <span>Status: Active</span>
                            <span>Users: 45</span>
                            <span>APIs: 8</span>
                        </div>
                    </div>
                    <div class="dept-card" style="border-left-color: #f093fb;">
                        <div class="dept-name">Department B</div>
                        <div class="dept-info">
                            <span><strong>Income & Eligibility</strong></span>
                            <span>Status: Active</span>
                            <span>Users: 38</span>
                            <span>APIs: 6</span>
                        </div>
                    </div>
                    <div class="dept-card" style="border-left-color: #4facfe;">
                        <div class="dept-name">Department C</div>
                        <div class="dept-info">
                            <span><strong>Scheme & Applications</strong></span>
                            <span>Status: Maintenance</span>
                            <span>Users: 52</span>
                            <span>APIs: 10</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RECENT ACTIVITY -->
            <div class="section">
                <div class="section-title">
                    <i class="fas fa-history"></i> System Activity Log
                </div>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>2026-08-31 14:32:15</td>
                            <td>Officer - Rajesh S.</td>
                            <td>Application #APP-2026-089 Approved</td>
                            <td><span class="health-status status-operational">Success</span></td>
                        </tr>
                        <tr>
                            <td>2026-08-31 14:15:42</td>
                            <td>Admin - System</td>
                            <td>Dept B API Sync Completed</td>
                            <td><span class="health-status status-warning">Warning</span></td>
                        </tr>
                        <tr>
                            <td>2026-08-31 14:01:08</td>
                            <td>Citizen - Priya V.</td>
                            <td>Consent Granted for Data Sharing</td>
                            <td><span class="health-status status-operational">Success</span></td>
                        </tr>
                        <tr>
                            <td>2026-08-31 13:45:33</td>
                            <td>Officer - Amit K.</td>
                            <td>Document Verification</td>
                            <td><span class="health-status status-operational">Success</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <script>
    </script>
</body>
</html>
